{
  "mcpServers": {
    "ynab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@maro-org/ynab-mcp"
      ],
      "env": {
        "YNAB_API_TOKEN": "${YNAB_API_TOKEN}",
        "YNAB_READ_ONLY": "false",
        "NODE_USE_ENV_PROXY": "1"
      }
    },
    "loseit": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "scripts/loseit-mcp.sh",
        "serve"
      ],
      "env": {
        "LOSEIT_EMAIL": "${LOSEIT_EMAIL}",
        "LOSEIT_PASSWORD": "${LOSEIT_PASSWORD}",
        "LOSEIT_STRONG_NAME": "3E11F631E46B7392706FBA11EDC2F9D1",
        "LOSEIT_POLICY_HASH": "F5AA51DFF7600BE94631854AFC5DEFE9"
      }
    }
  }
}
