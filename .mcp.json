{
  "mcpServers": {
    "ynab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@maro-org/ynab-mcp"
      ],
      "env": {
        "YNAB_API_TOKEN": "${YNAB_API_TOKEN}",
        "YNAB_READ_ONLY": "false",
        "NODE_USE_ENV_PROXY": "1"
      }
    },
    "loseit": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "scripts/loseit-mcp.sh",
        "serve"
      ],
      "env": {
        "LOSEIT_EMAIL": "${LOSEIT_EMAIL}",
        "LOSEIT_PASSWORD": "${LOSEIT_PASSWORD}",
        "LOSEIT_STRONG_NAME": "35F651C0C170664E204B31D0D0E573B1",
        "LOSEIT_POLICY_HASH": "1492F6221CAAEF5A225F836D2F8A0BDB"
      }
    }
  }
}
